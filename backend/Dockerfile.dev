FROM golang:1.23-alpine

WORKDIR /app

# Install git and air
RUN apk add --no-cache git \
    && go install github.com/air-verse/air@v1.61.1

# Copy dependency files first
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest of the application
COPY . .

EXPOSE 8080

# Run air for live-reloading
CMD ["air"]
